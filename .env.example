# Host port used to access the web application.
GOLF_PORT=8080

# Persistent host directory. On Unraid, use an appdata share path.
GOLF_DATA_DIR=/mnt/user/appdata/golf-ledger

# Path inside the container and mounted /data directory.
GOLF_DB=/data/golf.db

# Unraid's default nobody:users identity.
PUID=99
PGID=100

TZ=Australia/Melbourne

# Image published by the GitHub Actions workflow.
GOLF_IMAGE=ghcr.io/frankp/golf-handicap:latest
